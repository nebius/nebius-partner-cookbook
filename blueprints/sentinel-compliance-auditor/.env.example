# Nebius AI Studio — inference (required)
NEBIUS_API_KEY=
# Model for the Optimized agent (keys: deepseek-v4-pro, nemotron, kimi-k2, glm-5)
NEBIUS_MODEL=deepseek-v4-pro
# Sub-agent fan-out width for audit_sops / audit_all_sops
MAX_AUDIT_WORKERS=10

# OpenAI — Prototype/Grounded agents (optional)
OPENAI_API_KEY=

# Pinecone — SOP corpus retrieval (required)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sentinel-sops

# LangGraph recursion limit for the outer agent (cloud deployment)
LANGGRAPH_DEFAULT_RECURSION_LIMIT=25

# Tavily — live regulation grounding (optional)
TAVILY_API_KEY=

# LangSmith — observability (optional, auto-enabled when set)
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=sentinel-agent
# Per-SOP sub-agent traces (default on; ~6k extra spans per full audit)
SUBAGENT_TRACING=on

# Jira — ticket actuation
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_DEFAULT_ISSUE_TYPE=Task

# LangGraph server the UI talks to (local `make dev` or the cloud URL)
LANGGRAPH_URL=http://localhost:2024

# UI shared-secret gate for /api/* (REQUIRED — the UI refuses to start without it).
# Set a long random value (e.g. `openssl rand -hex 32`) when exposing the UI.
UI_API_KEY=
